# =============================================================================
# RecrutiTN - Docker Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to git - add to .gitignore
# =============================================================================

# =============================================================================
# DATABASE
# =============================================================================
DB_NAME=recrutement
DB_USER=postgres
# REQUIRED: Change this to a secure password
DB_PASSWORD=your_secure_password_here

# =============================================================================
# KEYCLOAK (Authentication)
# =============================================================================
KEYCLOAK_ADMIN=admin
# REQUIRED: Change this to a secure password
KEYCLOAK_PASSWORD=your_keycloak_admin_password

# =============================================================================
# AI SERVICE (External APIs - Recommended for Production)
# =============================================================================
# Get free API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: OpenRouter (for multiple LLM providers)
# Get key from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_key_here

# Local Ollama (optional - only if running Ollama on host)
# OLLAMA_HOST=http://host.docker.internal:11434

# =============================================================================
# BACKEND APPLICATION
# =============================================================================
APP_URL=http://localhost
APP_ENV=production
APP_DEBUG=false

# Laravel Security
APP_KEY=  # Generate with: php artisan key:generate --show
JWT_SECRET=  # Generate with: php artisan jwt:secret --show

# =============================================================================
# EMAIL (MailHog for development, SMTP for production)
# =============================================================================
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null

# For production (Gmail, SendGrid, etc):
# MAIL_HOST=smtp.gmail.com
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# =============================================================================
# FILE STORAGE
# =============================================================================
# AWS S3 (recommended for production)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-1
# AWS_BUCKET=recrutement-storage

# Or local storage (default)
FILESYSTEM_DISK=local

# =============================================================================
# MONITORING & LOGGING (Optional)
# =============================================================================
# SENTRY_DSN=your_sentry_dsn_here
# LOG_LEVEL=info

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable AI features
AI_MATCHING_ENABLED=true
AI_CHATBOT_ENABLED=true
AUTO_QUIZ_GENERATION=true

# Rate limiting
AI_RATE_LIMIT_PER_MINUTE=30
